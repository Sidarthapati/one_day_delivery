{
  "name": "godspeed-e2e",
  "private": true,
  "version": "0.2.0",
  "description": "Full-day end-to-end harness: Playwright (web consoles) + Maestro (DA/shuttle) + control plane.",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "smoke": "playwright test -c playwright/playwright.config.ts",
    "smoke:headed": "playwright test -c playwright/playwright.config.ts --headed",
    "report": "playwright show-report",
    "seed": "tsx orchestrator/seed.ts",
    "day": "tsx orchestrator/runDay.ts",
    "mobile:day": "tsx orchestrator/mobileDay.ts",
    "presence": "tsx orchestrator/refresh-presence.ts",
    "cleanup": "tsx orchestrator/cleanup-stuck.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.0",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "pg": "^8.12.0"
  }
}
