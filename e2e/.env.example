# Copy to e2e/.env (gitignored) and fill. Never commit real secrets.

# Backend under test (local Mac backend by default; emulator reaches it at 10.0.2.2:8080).
BACKEND_URL=http://localhost:8080

# Dedicated e2e Postgres (Render oneday-db-e2e external string, or a local throwaway DB).
E2E_DATABASE_URL=postgres://USER:PASS@HOST:5432/DBNAME?sslmode=require

# Six web consoles (local dev ports; airline moved off 3003 to avoid the business collision).
CUSTOMER_URL=http://localhost:3000
HUB_URL=http://localhost:3001
STATION_URL=http://localhost:3002
BUSINESS_URL=http://localhost:3003
ADMIN_URL=http://localhost:3004
AIRLINE_URL=http://localhost:3005

# Mobile (Maestro drives the Android emulator).
DRIVER_APP_ID=com.oneday.driver
MAESTRO_BIN=maestro

# Artifacts (screenshots, maestro output, reports).
E2E_OUT_DIR=artifacts

# --- Set these in the BACKEND's env when you run it (not read by the harness) ---
# SPRING_DATASOURCE_URL / SPRING_DATASOURCE_USERNAME / SPRING_DATASOURCE_PASSWORD  -> oneday-db-e2e
# CONSOLIDATOR_DATASOURCE_URL / ...USERNAME / ...PASSWORD                          -> .../consolidator
# CLOUDAMQP_URL (or the app's broker var)  -> amqps://jcgwhhze:***@puffin.rmq2.cloudamqp.com/jcgwhhze
# --- Set in each web app's env ---
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=...   (required for the business ship form to render)
