    {
      "id": "m1_scenarios_deactivation_immediate",
      "label": "Account Deactivation Takes Effect on Next Request",
      "file_type": "rationale",
      "source_file": "/Users/yashvardhan/Personal_Projects/one_day_delivery/docs/M1/SCENARIOS.md",
      "source_location": "Chapter 10",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "JWT filter re-checks active=true from DB on every request. Deactivation takes effect immediately on next request even if JWT is still valid. Role changes do NOT take effect until next login (stateless JWT trade-off)."
    },
