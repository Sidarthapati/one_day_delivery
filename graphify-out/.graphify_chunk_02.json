    {
      "id": "m2_pricing_design_rate_card_versioning",
      "label": "Rate Card Append-Only Versioning",
      "file_type": "rationale",
      "source_file": "/Users/yashvardhan/Personal_Projects/one_day_delivery/docs/M2/M2-PRICING-DESIGN.md",
      "source_location": "Section 4",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "rate_card rows are never mutated. Publishing a new version inserts a fresh ACTIVE row and flips the prior ACTIVE card to SUPERSEDED. Shipment stores rateCardVersion for historical reconciliation."
    },
    {
      "id": "m2_pricing_design_costing_model",
      "label": "M2 Per-Parcel Cost Floor Model",
      "file_type": "concept",
      "source_file": "/Users/yashvardhan/Personal_Projects/one_day_delivery/docs/M2/M2-PRICING-DESIGN.md",
      "source_location": "Section 5",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "floor = da_share + van_share + hub_cost + airline_cost. da_share divides by effective capacity (nameplate × 70% utilisation) so DA utilisation target raises the floor — consistent with M3/M5/M6 cost floor invariant."
    },
