    {
      "id": "m2_pricing_design_slab_model",
      "label": "M2 Weight Slab Pricing Model",
      "file_type": "concept",
      "source_file": "/Users/yashvardhan/Personal_Projects/one_day_delivery/docs/M2/M2-PRICING-DESIGN.md",
      "source_location": "Section 3",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Base covers first 0.5kg slab. Each additional 0.5kg slab decays 10pp, floored at 60%. Formula: pct(n) = max(60, 100 - 10*(n-1)). Designed so heavy parcels pay more but not linearly."
    },
    {
      "id": "m2_pricing_design_cod_surcharge",
      "label": "COD Surcharge: max(₹50, 1.5% GMV)",
