    {
      "id": "m1_role_permissions_city_scoped",
      "label": "City-Scoped Role Constraint",
      "file_type": "rationale",
      "source_file": "/Users/yashvardhan/Personal_Projects/one_day_delivery/docs/M1/ROLE-PERMISSIONS.md",
      "source_location": "Per-Role Breakdown",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "City-scoped roles (STATION_MANAGER, SUPERVISOR, HUB_OPERATOR, DELIVERY_ASSOCIATE, VAN_DRIVER, CRON_DRIVER, CALL_CENTER_AGENT) require cityId to prevent cross-city data access. Non-city-scoped roles (ADMIN, B2B_USER, B2C_CUSTOMER, C2C_CUSTOMER, AIRLINE_GHA) skip the city check."
    },
