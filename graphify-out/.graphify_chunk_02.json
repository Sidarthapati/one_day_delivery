      "file_type": "rationale",
      "source_file": "/Users/yashvardhan/Personal_Projects/one_day_delivery/docs/M2/M2-PRICING-DESIGN.md",
      "source_location": "Section 9-10",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "NoRateConfiguredException is excluded from the pricing circuit breaker because a missing rate is a business outcome, not a system failure. Repeated unpriced-lane attempts should not trip the breaker and 503 priced lanes."
    },
