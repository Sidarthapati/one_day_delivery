    {
      "id": "m1_scenarios_jwt_filter_chain",
      "label": "JWT Filter Chain Decision Tree",
      "file_type": "concept",
      "source_file": "/Users/yashvardhan/Personal_Projects/one_day_delivery/docs/M1/SCENARIOS.md",
      "source_location": "Chapter 3",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Filter always calls filterChain.doFilter() even on failure — leaves SecurityContext empty rather than short-circuiting. This allows the framework to return 403 for protected endpoints rather than a direct 401 in the filter."
    },
