{"nodes": [{"id": "decisions_md_decisions", "label": "Design Decisions Document \u2014 All Modules", "file_type": "document", "source_file": "docs/DECISIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "decisions_xc_d001_event_transport", "label": "XC-D-001 Event Transport: Kafka Async, HTTP Sync", "file_type": "rationale", "source_file": "docs/DECISIONS.md", "source_location": "XC-D-001", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Kafka decouples producers and consumers. When a module is extracted into its own service, no code changes needed \u2014 only deployment changes. Database polling degrades under load."}, {"id": "decisions_xc_d002_appendonly", "label": "XC-D-002 Append-Only Audit Trail Decision", "file_type": "rationale", "source_file": "docs/DECISIONS.md", "source_location": "XC-D-002", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Required for regulatory compliance, ops debugging, and SLA dispute resolution."}, {"id": "decisions_xc_d003_city_scoped", "label": "XC-D-003 City-Scoped Data Model", "file_type": "rationale", "source_file": "docs/DECISIONS.md", "source_location": "XC-D-003", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "decisions_xc_d007_tech_stack", "label": "XC-D-007 Technology Stack: Java 21, Spring Boot, PostgreSQL, Kafka", "file_type": "rationale", "source_file": "docs/DECISIONS.md", "source_location": "XC-D-007", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "decisions_m4_d001_b2b_b2c_separation", "label": "M4-D-001 B2B and B2C Use Separate API Endpoints", "file_type": "rationale", "source_file": "docs/DECISIONS.md", "source_location": "M4-D-001", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A single endpoint with customerType switch creates complex branching and leaks B2B concepts into B2C contract. Separate endpoints are independently versioned."}, {"id": "decisions_m4_d002_razorpay", "label": "M4-D-002 B2C Payment via Razorpay Prepaid", "file_type": "rationale", "source_file": "docs/DECISIONS.md", "source_location": "M4-D-002", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "decisions_m4_d005_eta_m9", "label": "M4-D-005 ETA Computation Entirely Owned by M9", "file_type": "rationale", "source_file": "docs/DECISIONS.md", "source_location": "M4-D-005", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "decisions_m4_d006_state_machine", "label": "M4-D-006 Shipment State Machine v2", "file_type": "rationale", "source_file": "docs/DECISIONS.md", "source_location": "M4-D-006", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "decisions_m4_d016_idempotency", "label": "M4-D-016 Booking Endpoint Idempotency", "file_type": "rationale", "source_file": "docs/DECISIONS.md", "source_location": "M4-D-016", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Network retries and double-taps are inevitable. Without idempotency, Razorpay capture could succeed while DB write fails, leaving customer charged without a shipment."}, {"id": "decisions_m4_d017_b2b_credit_atomicity", "label": "M4-D-017 B2B Credit Check Atomicity via SELECT FOR UPDATE", "file_type": "rationale", "source_file": "docs/DECISIONS.md", "source_location": "M4-D-017", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Concurrent B2B bookings from same account could race past credit limit check. Row-level locking serialises them."}, {"id": "decisions_m4_d018_circuit_breakers", "label": "M4-D-018 Resilience4j Circuit Breakers on Synchronous Calls", "file_type": "rationale", "source_file": "docs/DECISIONS.md", "source_location": "M4-D-018", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "decisions_m4_d019_cod", "label": "M4-D-019 COD in v1 for B2C and C2C", "file_type": "rationale", "source_file": "docs/DECISIONS.md", "source_location": "M4-D-019", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "decisions_m4_d020_pricing_m2", "label": "M4-D-020 All Pricing Owned by M2", "file_type": "rationale", "source_file": "docs/DECISIONS.md", "source_location": "M4-D-020", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Clear separation of concerns. Pricing rules change frequently. Having any pricing logic in M4 creates drift and debugging confusion."}, {"id": "decisions_m8_d001_qr_code", "label": "M8-D-001 QR Code Barcode Format", "file_type": "rationale", "source_file": "docs/DECISIONS.md", "source_location": "M8-D-001", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "DA app uses phone cameras for scanning; QR natively supported by modern phones without dedicated hardware. Risk: airport/GHA scanners may expect IATA standard."}, {"id": "decisions_bd001_cancellation", "label": "BD-001 Cancellation Policy \u2014 Pending Business Decision", "file_type": "rationale", "source_file": "docs/DECISIONS.md", "source_location": "BD-001", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "decisions_md_decisions", "target": "decisions_xc_d001_event_transport", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/DECISIONS.md", "source_location": "XC-D-001", "weight": 1.0}, {"source": "decisions_md_decisions", "target": "decisions_xc_d002_appendonly", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/DECISIONS.md", "source_location": "XC-D-002", "weight": 1.0}, {"source": "decisions_md_decisions", "target": "decisions_xc_d007_tech_stack", "relation": "re