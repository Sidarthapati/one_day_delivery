{"nodes": [{"id": "m2_pricing_design_slab_model", "label": "M2 Weight Slab Pricing Model", "file_type": "concept", "source_file": "docs/M2/M2-PRICING-DESIGN.md", "source_location": "Section 3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Base covers first 0.5kg slab. Each additional 0.5kg slab decays 10pp, floored at 60%. Formula: pct(n) = max(60, 100 - 10*(n-1)). Designed so heavy parcels pay more but not linearly."}, {"id": "m2_pricing_design_cod_surcharge", "label": "COD Surcharge: max(\u20b950, 1.5% GMV)", "file_type": "concept", "source_file": "docs/M2/M2-PRICING-DESIGN.md", "source_location": "Section 3", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "m2_pricing_design_rate_card_versioning", "label": "Rate Card Append-Only Versioning", "file_type": "rationale", "source_file": "docs/M2/M2-PRICING-DESIGN.md", "source_location": "Section 4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "rate_card rows are never mutated. Publishing a new version inserts a fresh ACTIVE row and flips the prior ACTIVE card to SUPERSEDED. Shipment stores rateCardVersion for historical reconciliation."}, {"id": "m2_pricing_design_costing_model", "label": "M2 Per-Parcel Cost Floor Model", "file_type": "concept", "source_file": "docs/M2/M2-PRICING-DESIGN.md", "source_location": "Section 5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "floor = da_share + van_share + hub_cost + airline_cost. da_share divides by effective capacity (nameplate \u00d7 70% utilisation) so DA utilisation target raises the floor \u2014 consistent with M3/M5/M6 cost floor invariant."}, {"id": "m2_pricing_design_maa_gap", "label": "Chennai (MAA) Pricing Gap", "file_type": "concept", "source_file": "docs/M2/M2-PRICING-DESIGN.md", "source_location": "Section 8", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "m2_pricing_design_circuit_breaker", "label": "Pricing Circuit Breaker (NoRateConfiguredException excluded)", "file_type": "rationale", "source_file": "docs/M2/M2-PRICING-DESIGN.md", "source_location": "Section 9-10", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "NoRateConfiguredException is excluded from the pricing circuit breaker because a missing rate is a business outcome, not a system failure. Repeated unpriced-lane attempts should not trip the breaker and 503 priced lanes."}], "edges": [{"source": "m2_pricing_design_slab_model", "target": "m2_api_docs_quote_endpoint", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/M2/M2-PRICING-DESIGN.md", "source_location": "Section 3", "weight": 1.0}, {"source": "m2_pricing_design_costing_model", "target": "m2_api_docs_cost_floor_endpoint", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/M2/M2-PRICING-DESIGN.md", "source_location": "Section 5", "weight": 1.0}, {"source": "m2_pricing_design_maa_gap", "target": "m2_api_docs_quote_endpoint", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/M2/M2-PRICING-DESIGN.md", "source_location": "Section 8", "weight": 1.0}, {"source": "m2_pricing_design_costing_model", "target": "m3_service_summaries_demand_scoring", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/M2/M2-PRICING-DESIGN.md", "source_location": "Section 5", "weight": 0.85}, {"source": "m2_pricing_design_rate_card_versioning", "target": "m3_implementation_plan_append_only", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/M2/M2-PRICING-DESIGN.md", "source_location": "Section 4", "weight": 0.85}], "hyperedges": [{"id": "m2_pricing_computation_chain", "label": "M2 Pricing Computation: Sl